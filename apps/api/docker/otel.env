# OpenTelemetry SDK of the api and api_consumers containers (env_file in
# compose.api.yml). Traces go to the APM Server of the "elastic" profile; when
# that profile is off, the export fails fast and the traces are dropped.
# Logs and metrics are not sent from PHP: Filebeat and Metricbeat collect them.
# OTEL_SERVICE_NAME and the secret token are set per service in compose.api.yml.
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://apm_server:8200
# CA created by elastic_setup (volume elastic_certs, mounted read-only)
OTEL_EXPORTER_OTLP_CERTIFICATE=/etc/elastic-certs/ca/ca.crt
# Milliseconds. Kept low: PHP-FPM exports after the response is sent, but a
# worker stays busy until the export ends.
OTEL_EXPORTER_OTLP_TIMEOUT=1000
OTEL_BSP_SCHEDULE_DELAY=5000
