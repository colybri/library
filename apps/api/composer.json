{
    "name": "colybri/library",
    "type": "project",
    "license": "MIT",
    "description": "A minimal Symfony project recommended to create bare bones applications",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-amqp": "*",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "beberlei/assert": "^3.2",
        "colybri/criteria": "^1.1",
        "doctrine/dbal": "^4.2",
        "doctrine/doctrine-bundle": "^2.11",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "elastic/ecs-logging": "^2.0",
        "fale/isbn": "^3.1",
        "guzzlehttp/guzzle": "^7.4",
        "league/flysystem-aws-s3-v3": "^3.35",
        "league/flysystem-bundle": "^3.7",
        "lexik/jwt-authentication-bundle": "^3.1",
        "open-telemetry/exporter-otlp": "^1.4",
        "open-telemetry/opentelemetry-auto-ext-amqp": "^0.1",
        "open-telemetry/opentelemetry-auto-pdo": "^0.6",
        "open-telemetry/opentelemetry-auto-symfony": "^1.7",
        "open-telemetry/sdk": "^1.15",
        "pccomponentes/ddd": "^4.6",
        "pccomponentes/ddd-logging": "^3.2",
        "pccomponentes/messenger-bundle": "^4.2",
        "pccomponentes/topic-generator": "^2.0.1",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/monolog-bundle": "^3.10",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/stopwatch": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/soyuka/swagger-ui.git"
        }
    ],
    "require-dev": {
        "behat/behat": "^3.11",
        "friends-of-behat/symfony-extension": "^2.4",
        "imbo/behat-api-extension": "^6.1",
        "php-parallel-lint/php-parallel-lint": "^1.3",
        "phpmetrics/phpmetrics": "^2.8",
        "phpro/grumphp": "^2.10",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-beberlei-assert": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.6",
        "symfony/var-dumper": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": false,
            "phpro/grumphp": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "tbachert/spi": true
        },
        "platform": {
            "php": "8.4.27"
        }
    },
    "autoload": {
        "psr-4": {
            "Colybri\\Library\\": "src/"
        },
        "files": [
            "config/opentelemetry.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Colybri\\Library\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts",
            "[ ! -x vendor/bin/grumphp ] || vendor/bin/grumphp git:init"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*",
            "docker": true
        }
    }
}
