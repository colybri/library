includes:
	- ./vendor/phpstan/phpstan-beberlei-assert/extension.neon
	- ./vendor/phpstan/phpstan-symfony/extension.neon
	- ./phpstan-baseline.neon
parameters:
    level: 3
    checkMissingIterableValueType: false
    paths:
        - src
        - tests
    excludePaths:
        - tests/Entrypoint/*

