# Default values for every environment variable the application reads.
# Copy this file to .env (git-ignored) and fill in the real values.
# Symfony's Dotenv falls back to this file when .env does not exist (CI).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=ChangeMe
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://library:library@127.0.0.1:5432/library?serverVersion=13&charset=utf8"
###< doctrine/doctrine-bundle ###

POSTGRES_WRITE_HOST=127.0.0.1
POSTGRES_WRITE_PORT=5432
POSTGRES_WRITE_DB=library
POSTGRES_WRITE_USER=library
POSTGRES_WRITE_PASS=library
POSTGRES_WRITE_VERSION=13
POSTGRES_WRITE_CHARSET=utf8

POSTGRES_READ_HOST=127.0.0.1
POSTGRES_READ_PORT=5432
POSTGRES_READ_DB=library
POSTGRES_READ_USER=library
POSTGRES_READ_PASS=library
POSTGRES_READ_VERSION=13
POSTGRES_READ_CHARSET=utf8

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

GOOGLE_BOOKS_API_KEY=
