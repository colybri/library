# Variables for docker compose and the root Makefile.
# Copy this file to .env (git-ignored) and fill in the real values.
# Symfony has its own file: apps/api/.env (see apps/api/.env.dist).
# A password containing $ must be written with $$ or wrapped in single quotes.

# Host user, so files created in the containers belong to you: USER_ID=$(id -u)
USER_ID=1000

# Postgres superuser created on first start (must match POSTGRES_*_USER/PASS in apps/api/.env)
POSTGRES_READ_USER=library
POSTGRES_READ_PASS=library

# Must match REDIS_URL in apps/api/.env. Required: Redis does not start without it
REDIS_PASSWORD=changeme-redis

# Must match RABBITMQ_LOGIN/RABBITMQ_PASSWORD in apps/api/.env
RABBITMQ_LOGIN=guest
RABBITMQ_PASSWORD=guest

# pgAdmin login (http://127.0.0.1:5050)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme-pgadmin

# Host address the ports are published on. 127.0.0.1 (default): only this
# machine. 0.0.0.0: every network the machine is on.
# INFRA_BIND_ADDR: postgres, redis, rabbitmq and pgadmin
# API_BIND_ADDR: the API (nginx 80/443); /_profiler stays local anyway
INFRA_BIND_ADDR=127.0.0.1
API_BIND_ADDR=127.0.0.1

# SeaweedFS (S3) for the files of the edition resources.
# Must match S3_ACCESS_KEY/S3_SECRET_KEY/S3_BUCKET in apps/api/.env
S3_ACCESS_KEY=library
S3_SECRET_KEY=changeme-s3-secret
S3_BUCKET=library-resources

# PHP image: pcov (default) or xdebug
COVERAGE_DRIVER=pcov

# Elastic stack (make elastic-up). Pinned version of Elasticsearch and Kibana.
ELASTIC_VERSION=9.5.5
# Password of the "elastic" superuser: your Kibana login
ELASTIC_PASSWORD=changeme-elastic
# Password of the internal kibana_system user (Kibana uses it, you never type it)
KIBANA_SYSTEM_PASSWORD=changeme-kibana-system
# At least 32 random characters, e.g. openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=changeme-at-least-32-characters-long-key
# Password of library_apm, the user the APM Server writes to Elasticsearch with
APM_ES_PASSWORD=changeme-apm
# Token the API sends to the APM Server. Letters and digits only (it goes in an
# HTTP header), e.g. openssl rand -hex 24
APM_SECRET_TOKEN=changemeapmsecrettoken
# Password of library_beats, the user Filebeat and Metricbeat write with
BEATS_ES_PASSWORD=changeme-beats
# Java heap of Elasticsearch: 1g is enough locally, raise it if you have the RAM
ES_HEAP=1g
# How long logs, metrics and traces are kept
ELASTIC_RETENTION=7d
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
APM_SERVER_PORT=8200
